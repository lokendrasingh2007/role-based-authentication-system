# ─── MongoDB ────────────────────────────────────────────────────────────────
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/<dbname>
DATABASE_URL="mongodb+srv://your_user:your_password@cluster.mongodb.net/auth_db?retryWrites=true&w=majority"

# Separate database for automated tests (NEVER point to production)
TEST_DATABASE_URL="mongodb://127.0.0.1:27017/auth_db_test"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_64_byte_random_hex_string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend origin — no trailing slash
CORS_ORIGIN="http://localhost:3000"

# ─── Admin Seed ──────────────────────────────────────────────────────────────
# Used ONLY by the seed script — never commit real values
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2024"
SEED_ADMIN_FIRST_NAME="Super"
SEED_ADMIN_LAST_NAME="Admin"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
